# PostgreSQL
DB_NAME=note_app
DB_USERNAME=note_user
DB_PASSWORD=replace_with_a_strong_database_password

# Predefined instructor account
DEMO_USERNAME=demo
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=replace_with_a_strong_demo_password

# Used when running the application outside Compose
SPRING_PROFILES_ACTIVE=prod
DB_HOST=localhost
DB_PORT=5432

# Host interface PostgreSQL is published on, for GUI database clients.
# Defaults to 127.0.0.1 (VPS-local only). Set to a private VPN address such as a
# Tailscale 100.x.x.x to reach it from another machine on that network.
# Never set this to 0.0.0.0 on an internet-facing host.
# DB_BIND_ADDR=127.0.0.1
